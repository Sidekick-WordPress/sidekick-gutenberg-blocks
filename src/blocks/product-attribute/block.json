{
    "apiVersion": 3,
    "name": "sgb/product-attribute",
    "title": "Product Attribute",
    "category": "design",
    "icon": "tag",
    "description": "Outputs a single product attribute value (e.g. Caliber) with an optional prefix/suffix. Reads the value directly from the product, so it works whether or not the attribute has archives enabled.",
    "usesContext": ["postId"],
    "attributes": {
        "attribute": {
            "type": "string",
            "default": "pa_caliber"
        },
        "prefix": {
            "type": "string",
            "default": "Cal: "
        },
        "suffix": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "spacing": {
            "margin": true,
            "padding": true
        },
        "typography": {
            "fontSize": true,
            "__experimentalFontWeight": true
        }
    },
    "textdomain": "sidekick-gutenberg-blocks"
}
