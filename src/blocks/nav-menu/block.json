{
    "apiVersion": 3,
    "name": "sgb/nav-menu",
    "title": "Sidekick Nav Menu",
    "category": "design",
    "icon": "menu",
    "attributes": {
        "ref": {
            "type": "number",
            "default": 0
        },
        "orientation": {
            "type": "string",
            "default": "horizontal"
        },
        "justifyContent": {
            "type": "string",
            "default": "right"
        },
        "gap": {
            "type": "number",
            "default": 24
        },
        "mobileGap": {
            "type": "number",
            "default": 12
        },
        "desktopBreakpoint": {
            "type": "number",
            "default": 768
        }
    },
    "supports": {
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontFamily": true,
            "__experimentalFontWeight": true,
            "__experimentalFontStyle": true,
            "__experimentalTextTransform": true,
            "__experimentalTextDecoration": true,
            "__experimentalLetterSpacing": true,
            "__experimentalDefaultControls": {
                "fontSize": true,
                "fontFamily": true
            }
        }
    }
}
